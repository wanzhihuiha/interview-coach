<?xml version="1.0" encoding="utf-8"?>
<mxfile host="app.diagrams.net" modified="2026-08-03T06:55:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="overview" name="一眼看懂-岗位解析生命周期">
    <mxGraphModel fold="1" pageWidth="1600" dx="1600" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1000" dy="1000" gridSize="10" pageScale="1" page="1" arrows="1">
      <root>
        <mxCell id="overview-0" />
        <mxCell id="overview-1" parent="overview-0" />
        <mxCell id="overview-title" value="岗位上传与解析生命周期：改造后一眼看懂" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="overview-1">
          <mxGeometry x="40" y="20" width="1520" height="42" as="geometry" />
        </mxCell>
        <mxCell id="overview-subtitle" value="请求只负责安全接收和创建任务；后台按用户公平排队；MySQL 保存最终事实，Redis 队列随时可重建。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#4b5563;" vertex="1" parent="overview-1">
          <mxGeometry x="40" y="64" width="1520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ov-rq" value="请求内" style="swimlane;html=1;startSize=32;horizontal=0;rounded=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=14;fontStyle=1;fontColor=#334155;" vertex="1" parent="overview-1">
          <mxGeometry x="40" y="120" width="1520" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ov-q" value="排队与调度" style="swimlane;html=1;startSize=32;horizontal=0;rounded=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=14;fontStyle=1;fontColor=#334155;" vertex="1" parent="overview-1">
          <mxGeometry x="40" y="330" width="1520" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ov-w" value="后台执行与确认" style="swimlane;html=1;startSize=32;horizontal=0;rounded=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=14;fontStyle=1;fontColor=#334155;" vertex="1" parent="overview-1">
          <mxGeometry x="40" y="540" width="1520" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ov-n1" value="&lt;b&gt;1. 用户提交岗位&lt;/b&gt;&lt;br&gt;粘贴 JD 或上传 PDF / TXT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="overview-1">
          <mxGeometry x="120" y="172" width="250" height="82" as="geometry" />
        </mxCell>
        <mxCell id="ov-n2" value="&lt;b&gt;2. 安全提取与校验&lt;/b&gt;&lt;br&gt;真实类型、资源上限、最多 2000 字&lt;br&gt;请求结束前清理临时资源" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="overview-1">
          <mxGeometry x="500" y="162" width="280" height="102" as="geometry" />
        </mxCell>
        <mxCell id="ov-n3" value="&lt;b&gt;3. 一个短事务写入 MySQL&lt;/b&gt;&lt;br&gt;个人或公共岗位 + WAITING 当前任务&lt;br&gt;taskId 同时作为参与者内固定排序号" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="overview-1">
          <mxGeometry x="920" y="162" width="300" height="102" as="geometry" />
        </mxCell>
        <mxCell id="ov-n4" value="&lt;b&gt;4. 不同参与者轮流排队&lt;/b&gt;&lt;br&gt;个人用户各自一队，全部公共任务共用 PUBLIC&lt;br&gt;每轮只取该参与者最早的 WAITING" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="overview-1">
          <mxGeometry x="250" y="372" width="300" height="102" as="geometry" />
        </mxCell>
        <mxCell id="ov-n5" value="&lt;b&gt;5. 先取得本机解析容量&lt;/b&gt;&lt;br&gt;没有空位就继续排队，不取 Redis、不访问数据库&lt;br&gt;有空位才尝试预留和领取任务" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="overview-1">
          <mxGeometry x="700" y="372" width="300" height="102" as="geometry" />
        </mxCell>
        <mxCell id="ov-n6" value="&lt;b&gt;6. 数据库再次确认任务仍可执行&lt;/b&gt;&lt;br&gt;只把有效的“等待中”任务改成“解析中”&lt;br&gt;同一用户最多运行一个任务" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="overview-1">
          <mxGeometry x="1150" y="372" width="300" height="102" as="geometry" />
        </mxCell>
        <mxCell id="ov-n7" value="&lt;b&gt;7. 事务外调用 CPA 并校验结果&lt;/b&gt;&lt;br&gt;合法画像保存为 SUCCEEDED 候选；异常写 FAILED&lt;br&gt;不生成基础兜底画像，远程等待不占数据库事务" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="overview-1">
          <mxGeometry x="330" y="582" width="330" height="102" as="geometry" />
        </mxCell>
        <mxCell id="ov-n8" value="&lt;b&gt;8. 所有者或管理员确认后才发布&lt;/b&gt;&lt;br&gt;确认写正式画像并删除当前任务；公共岗位立即公开&lt;br&gt;失败时可重试，旧正式画像始终保持可用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="overview-1">
          <mxGeometry x="920" y="582" width="350" height="102" as="geometry" />
        </mxCell>
        <mxCell id="ov-e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="overview-1" source="ov-n1" target="ov-n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="overview-1" source="ov-n2" target="ov-n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e34" value="事务提交后尝试入队" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;" edge="1" parent="overview-1" source="ov-n3" target="ov-n4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1070" y="300" />
              <mxPoint x="400" y="300" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ov-e45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="overview-1" source="ov-n4" target="ov-n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="overview-1" source="ov-n5" target="ov-n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-e67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;" edge="1" parent="overview-1" source="ov-n6" target="ov-n7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1300" y="510" />
              <mxPoint x="495" y="510" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ov-e78" value="成功：等待用户确认" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="overview-1" source="ov-n7" target="ov-n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-truth" value="&lt;b&gt;为什么 Redis 队列丢了也不会丢任务&lt;/b&gt;&lt;br&gt;MySQL 保存当前任务真实状态；Redis 只保存可重建投影。应用启动时收口遗留 RUNNING，再按 taskId 恢复有效 WAITING；当前实现不持续扫描数据库，运行中投影失败依赖告警和下次启动重建。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="overview-1">
          <mxGeometry x="80" y="770" width="700" height="112" as="geometry" />
        </mxCell>
        <mxCell id="ov-ui" value="&lt;b&gt;页面必须同时显示两件事&lt;/b&gt;&lt;br&gt;正式画像是否可用（profileUsable）：决定能否继续面试。&lt;br&gt;当前任务状态（latestTaskStatus）：WAITING、RUNNING、SUCCEEDED 或 FAILED。&lt;br&gt;仅 WAITING/RUNNING 持续轮询；隐藏暂停、可见恢复、卸载取消，不设 60 秒总上限。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="overview-1">
          <mxGeometry x="820" y="770" width="700" height="112" as="geometry" />
        </mxCell>
        <mxCell id="ov-nt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=4 4;strokeColor=#9ca3af;strokeWidth=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="overview-1" source="ov-truth" target="ov-n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-nu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=4 4;strokeColor=#9ca3af;strokeWidth=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="overview-1" source="ov-ui" target="ov-n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-legend" value="颜色：蓝色＝主流程　绿色＝成功/可用　红色＝拒绝/失败　紫色＝事务与最终写入　灰色＝恢复、说明和异步补偿" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#6b7280;" vertex="1" parent="overview-1">
          <mxGeometry x="140" y="920" width="1320" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="gap" name="现状和目标差距">
    <mxGraphModel fold="1" pageWidth="1600" dx="1600" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1000" dy="1000" gridSize="10" pageScale="1" page="1" arrows="1">
      <root>
        <mxCell id="gap-0" />
        <mxCell id="gap-1" parent="gap-0" />
        <mxCell id="gap-title" value="为什么要改：现状行为与目标行为逐项对照" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="gap-1">
          <mxGeometry x="40" y="20" width="1520" height="42" as="geometry" />
        </mxCell>
        <mxCell id="gap-subtitle" value="左侧是改造前问题；右侧是当前已落地设计。中间箭头表示本 Goal 完成的行为切换。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#4b5563;" vertex="1" parent="gap-1">
          <mxGeometry x="40" y="64" width="1520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="g-lh" value="当前问题" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="gap-1">
          <mxGeometry x="90" y="115" width="560" height="52" as="geometry" />
        </mxCell>
        <mxCell id="g-rh" value="目标设计" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="gap-1">
          <mxGeometry x="950" y="115" width="560" height="52" as="geometry" />
        </mxCell>
        <mxCell id="g-l0" value="&lt;b&gt;创建请求实际一直等模型回答&lt;/b&gt;&lt;br&gt;同一个服务内部直接调用“异步方法”，Spring 没有机会切到后台执行；所以接口迟迟不返回，前端按钮一直转圈。（代码表现：同类调用 @Async）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="gap-1">
          <mxGeometry x="90" y="195" width="560" height="92" as="geometry" />
        </mxCell>
        <mxCell id="g-r0" value="&lt;b&gt;请求只做到“任务已创建”&lt;/b&gt;&lt;br&gt;安全提取和事务成功后立即返回；后台调度器独立执行，不依赖同类 @Async。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="gap-1">
          <mxGeometry x="950" y="195" width="560" height="92" as="geometry" />
        </mxCell>
        <mxCell id="g-e0" value="改造" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="gap-1" source="g-l0" target="g-r0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-l1" value="&lt;b&gt;原文件永久落盘但无人使用&lt;/b&gt;&lt;br&gt;保存路径未持久化；删除岗位也不删文件，长期运行会持续占满磁盘。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="gap-1">
          <mxGeometry x="90" y="310" width="560" height="92" as="geometry" />
        </mxCell>
        <mxCell id="g-r1" value="&lt;b&gt;只保存受限的 JD 文本&lt;/b&gt;&lt;br&gt;文件仅在上传请求内用于提取；临时资源 finally 清理，不再保存长期文件路径。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="gap-1">
          <mxGeometry x="950" y="310" width="560" height="92" as="geometry" />
        </mxCell>
        <mxCell id="g-e1" value="改造" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="gap-1" source="g-l1" target="g-r1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-l2" value="&lt;b&gt;一个 parseStatus 承担两种含义&lt;/b&gt;&lt;br&gt;重新解析时无法表达“旧正式画像仍可用，但新任务正在运行”。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="gap-1">
          <mxGeometry x="90" y="425" width="560" height="92" as="geometry" />
        </mxCell>
        <mxCell id="g-r2" value="&lt;b&gt;拆开正式画像与最新任务&lt;/b&gt;&lt;br&gt;profileUsable 表示能否面试；latestTaskStatus 单独表示本轮状态。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="gap-1">
          <mxGeometry x="950" y="425" width="560" height="92" as="geometry" />
        </mxCell>
        <mxCell id="g-e2" value="改造" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="gap-1" source="g-l2" target="g-r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-l3" value="&lt;b&gt;没有持久任务与公平顺序&lt;/b&gt;&lt;br&gt;进程崩溃会丢失执行；直接限制两个线程会让后来用户随机失败或长期等待。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="gap-1">
          <mxGeometry x="90" y="540" width="560" height="92" as="geometry" />
        </mxCell>
        <mxCell id="g-r3" value="&lt;b&gt;数据库保存任务，Redis 只负责轮流叫号&lt;/b&gt;&lt;br&gt;Redis 丢失后任务仍在；同一用户一次只运行一个任务，不同用户按轮次各取一个。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="gap-1">
          <mxGeometry x="950" y="540" width="560" height="92" as="geometry" />
        </mxCell>
        <mxCell id="g-e3" value="改造" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="gap-1" source="g-l3" target="g-r3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-l4" value="&lt;b&gt;超时与并发名额没有闭环&lt;/b&gt;&lt;br&gt;把工作扔到后台，仍可能变成后台线程永久等待；名额也可能过早释放。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="gap-1">
          <mxGeometry x="90" y="655" width="560" height="92" as="geometry" />
        </mxCell>
        <mxCell id="g-r4" value="&lt;b&gt;容量与远程调用真实生命周期绑定&lt;/b&gt;&lt;br&gt;岗位模块不自建 deadlineAt；依赖共享 CPA/LLM 最终上限。底层调用、状态收口和清理真正结束后才释放本机执行名额。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="gap-1">
          <mxGeometry x="950" y="655" width="560" height="92" as="geometry" />
        </mxCell>
        <mxCell id="g-e4" value="改造" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="gap-1" source="g-l4" target="g-r4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-l5" value="&lt;b&gt;页面固定轮询约 60 秒&lt;/b&gt;&lt;br&gt;长回答尚未结束时页面停止刷新，用户不知道排队、失败还是卡死。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="gap-1">
          <mxGeometry x="90" y="770" width="560" height="92" as="geometry" />
        </mxCell>
        <mxCell id="g-r5" value="&lt;b&gt;可解释的等待、终态与重试&lt;/b&gt;&lt;br&gt;显示前方等待量快照；持续轮询到 SUCCEEDED/FAILED，失败原因分类后允许重新解析。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="gap-1">
          <mxGeometry x="950" y="770" width="560" height="92" as="geometry" />
        </mxCell>
        <mxCell id="g-e5" value="改造" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="gap-1" source="g-l5" target="g-r5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-scope" value="&lt;b&gt;本图范围&lt;/b&gt;：当前确定单实例运行；岗位解析必须优先并使用独立 CPA 容量。CPA 多账户/多 Key 由其他负责人设计，本图只依赖可配置的“获取/释放容量”接口；多实例租约仅预留扩展点。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="gap-1">
          <mxGeometry x="190" y="900" width="1220" height="58" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="create" name="详细设计-创建岗位与入队">
    <mxGraphModel fold="1" pageWidth="1800" dx="1800" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1400" dy="1400" gridSize="10" pageScale="1" page="1" arrows="1">
      <root>
        <mxCell id="create-0" />
        <mxCell id="create-1" parent="create-0" />
        <mxCell id="create-title" value="详细设计：创建岗位与可靠入队" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="create-1">
          <mxGeometry x="40" y="20" width="1720" height="42" as="geometry" />
        </mxCell>
        <mxCell id="create-subtitle" value="失败上传不占额度；成功请求只承诺 MySQL 已有任务；Redis 入队失败不能造成任务丢失。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#4b5563;" vertex="1" parent="create-1">
          <mxGeometry x="40" y="64" width="1720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ce-guide" value="&lt;b&gt;本页怎么读&lt;/b&gt;&lt;br&gt;输入：岗位名称 + 已校验的 JD 文本。&lt;br&gt;成功口径：数据库同时保存岗位和唯一 WAITING 当前任务，然后立即返回。&lt;br&gt;个人失败事务不消耗 5 分钟频控；公共岗位走管理员独立入口。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="create-1">
          <mxGeometry x="40" y="110" width="500" height="145" as="geometry" />
        </mxCell>
        <mxCell id="ce-s" value="创建或上传岗位请求" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;" vertex="1" parent="create-1">
          <mxGeometry x="760" y="110" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ce-auth" value="&lt;b&gt;由服务端入口固定资源类型和归属&lt;/b&gt;&lt;br&gt;普通入口创建本人个人岗位；ADMIN 入口创建公共岗位&lt;br&gt;客户端不能传 ownerId / isPublic 改变归属" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="create-1">
          <mxGeometry x="650" y="205" width="480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ce-input" value="&lt;b&gt;校验岗位名称和 JD 文本&lt;/b&gt;&lt;br&gt;粘贴文本或文件提取结果都必须为 1～2000 个完整字符（Unicode code point）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="create-1">
          <mxGeometry x="650" y="310" width="480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ce-lock" value="&lt;b&gt;按资源类型进入并发保护&lt;/b&gt;&lt;br&gt;个人：事务第一条读取锁 sys_user 行&lt;br&gt;公共：事务外先取得固定 Redisson PUBLIC 提交锁" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="create-1">
          <mxGeometry x="650" y="415" width="480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ce-check" value="&lt;b&gt;在数据库短事务中核对限制&lt;/b&gt;&lt;br&gt;个人新建：未归档岗位 &amp;lt; 5、WAITING &amp;lt; 5、距上次成功发起已满 5 分钟&lt;br&gt;公共：PUBLIC 的 WAITING &amp;lt; 配置上限（默认 20）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="create-1">
          <mxGeometry x="620" y="520" width="540" height="92" as="geometry" />
        </mxCell>
        <mxCell id="ce-ok" value="四条规则都满足？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=4;" vertex="1" parent="create-1">
          <mxGeometry x="800" y="650" width="180" height="86" as="geometry" />
        </mxCell>
        <mxCell id="ce-write" value="&lt;b&gt;一次提交同时保存岗位和当前任务&lt;/b&gt;&lt;br&gt;个人或公共活动岗位；唯一 WAITING 任务；服务端 queueOwner&lt;br&gt;任务自增 id 同时作为参与者内部固定排序号" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="create-1">
          <mxGeometry x="610" y="775" width="560" height="92" as="geometry" />
        </mxCell>
        <mxCell id="ce-commit" value="提交数据库事务并释放用户短锁&lt;br&gt;此刻创建请求已经成功" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="create-1">
          <mxGeometry x="700" y="900" width="380" height="66" as="geometry" />
        </mxCell>
        <mxCell id="ce-return" value="&lt;b&gt;立即返回：解析任务已受理&lt;/b&gt;&lt;br&gt;positionId、positionName、taskId&lt;br&gt;latestTaskStatus = WAITING" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="create-1">
          <mxGeometry x="620" y="1010" width="540" height="84" as="geometry" />
        </mxCell>
        <mxCell id="ce-invalid" value="POSITION_NAME_EMPTY / JD_CONTENT_EMPTY&lt;br&gt;JD_CONTENT_TOO_LONG / PROFILE_DATA_INVALID&lt;br&gt;不创建岗位，不计入 5 分钟频控" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="create-1">
          <mxGeometry x="80" y="305" width="430" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ce-busy" value="POSITION_PUBLIC_SUBMISSION_BUSY&lt;br&gt;公共提交锁不可用或未取得，失败关闭&lt;br&gt;个人提交由数据库用户行锁串行化" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="create-1">
          <mxGeometry x="80" y="410" width="430" height="82" as="geometry" />
        </mxCell>
        <mxCell id="ce-reject" value="POSITION_LIMIT_EXCEEDED：个人未归档岗位已满&lt;br&gt;POSITION_WAITING_LIMIT_EXCEEDED：参与者等待任务已满&lt;br&gt;POSITION_SUBMISSION_TOO_FREQUENT：个人 5 分钟频控未到" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="create-1">
          <mxGeometry x="55" y="640" width="500" height="105" as="geometry" />
        </mxCell>
        <mxCell id="ce-db-error" value="事务异常：由统一异常处理返回&lt;br&gt;整体回滚，不产生孤立岗位或任务&lt;br&gt;不虚构额外岗位业务错误码" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="create-1">
          <mxGeometry x="80" y="790" width="430" height="88" as="geometry" />
        </mxCell>
        <mxCell id="ce-enqueue" value="&lt;b&gt;后台动作，不阻塞左侧返回&lt;/b&gt;&lt;br&gt;把任务幂等加入该用户的先进先出队列；该用户没有运行中任务且尚未参加轮转时，才把用户放到轮转队尾" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="create-1">
          <mxGeometry x="1220" y="885" width="500" height="92" as="geometry" />
        </mxCell>
        <mxCell id="ce-repair" value="Redis 写入失败也不回滚岗位&lt;br&gt;MySQL 中的 WAITING 仍有效；有限重试耗尽后记录告警&lt;br&gt;当前实现依赖下次应用启动按 taskId 重建，不持续扫描数据库" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="create-1">
          <mxGeometry x="1220" y="1015" width="500" height="88" as="geometry" />
        </mxCell>
        <mxCell id="ce-idem" value="&lt;b&gt;为什么并发提交不能穿透限制&lt;/b&gt;&lt;br&gt;个人先锁 sys_user 行，串行检查岗位数、等待数和频控；公共用固定 PUBLIC 提交锁串行检查等待数；position_id 唯一约束最终保证一岗位一任务。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="create-1">
          <mxGeometry x="1190" y="405" width="510" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ce-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="create-1" source="ce-s" target="ce-auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="create-1" source="ce-auth" target="ce-input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce-e3" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="create-1" source="ce-input" target="ce-lock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce-e3x" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="create-1" source="ce-input" target="ce-invalid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce-e4" value="取得" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="create-1" source="ce-lock" target="ce-check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce-e4x" value="未取得" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="create-1" source="ce-lock" target="ce-busy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="create-1" source="ce-check" target="ce-ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce-e6" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="create-1" source="ce-ok" target="ce-write">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce-e6x" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="create-1" source="ce-ok" target="ce-reject">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="create-1" source="ce-write" target="ce-commit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce-e7x" value="异常" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="create-1" source="ce-write" target="ce-db-error">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce-e8" value="立即响应" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="create-1" source="ce-commit" target="ce-return">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce-e9" value="提交成功后触发" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=1 3;strokeColor=#111827;strokeWidth=2;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="create-1" source="ce-commit" target="ce-enqueue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce-e10" value="告警；下次启动重建" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=1 3;strokeColor=#111827;strokeWidth=2;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="create-1" source="ce-enqueue" target="ce-repair">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce-n1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=1 3;strokeColor=#111827;strokeWidth=2;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="create-1" source="ce-lock" target="ce-idem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce-rate" value="&lt;b&gt;5 分钟限频从什么时候开始算&lt;/b&gt;：只有数据库事务成功提交才算一次“成功发起”。文件校验失败、提取失败或事务回滚都不消耗限频；新建和重新解析共用同一时间。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="create-1">
          <mxGeometry x="240" y="1160" width="1320" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ce-config" value="&lt;b&gt;当前不启用“预计等太久就拒绝提交”&lt;/b&gt;：先用每用户最多 5 个等待任务和 5 分钟限频控制积压；拿到真实吞吐量、P95/P99 等待时间和 CPA 容量数据后再评估是否开启。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="create-1">
          <mxGeometry x="360" y="1270" width="1080" height="72" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="extract" name="详细设计-文件安全提取">
    <mxGraphModel fold="1" pageWidth="2200" dx="2200" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1580" dy="1580" gridSize="10" pageScale="1" page="1" arrows="1">
      <root>
        <mxCell id="extract-0" />
        <mxCell id="extract-1" parent="extract-0" />
        <mxCell id="extract-title" value="详细设计：PDF / TXT 文件安全提取" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="extract-1">
          <mxGeometry x="40" y="20" width="2120" height="42" as="geometry" />
        </mxCell>
        <mxCell id="extract-subtitle" value="后端只接收受限的 PDF / TXT，提取出最多 2000 个完整字符；原文件和临时路径都不长期保存。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#4b5563;" vertex="1" parent="extract-1">
          <mxGeometry x="40" y="64" width="2120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="fe-guide" value="&lt;b&gt;本页怎么读&lt;/b&gt;&lt;br&gt;前端校验只用于尽早提示，不能替代后端判断。&lt;br&gt;后端重新检查实际字节数、内容特征、编码、PDF 页数、字符数和提取超时。&lt;br&gt;无论成功还是失败，都会关闭资源并尝试删除临时文件。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="extract-1">
          <mxGeometry x="40" y="110" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="fe-s" value="用户在前端选择 PDF 或 TXT" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;" vertex="1" parent="extract-1">
          <mxGeometry x="970" y="110" width="260" height="58" as="geometry" />
        </mxCell>
        <mxCell id="fe-front" value="&lt;b&gt;前端先做快速提示&lt;/b&gt;&lt;br&gt;检查扩展名和浏览器可见大小；能在本地取得文本时，再预检查是否为 1～2000 个完整字符" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="extract-1">
          <mxGeometry x="860" y="205" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fe-upload" value="按 multipart/form-data 上传文件&lt;br&gt;后端从头执行权威校验" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="extract-1">
          <mxGeometry x="890" y="320" width="420" height="62" as="geometry" />
        </mxCell>
        <mxCell id="fe-size" value="&lt;b&gt;边读取边检查实际文件大小&lt;/b&gt;&lt;br&gt;请求头中的 Content-Length 只用于提前拒绝；实际读取字节达到配置上限时立即停止" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="extract-1">
          <mxGeometry x="840" y="415" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fe-temp" value="&lt;b&gt;写入非持久临时目录&lt;/b&gt;&lt;br&gt;服务端生成随机文件名；客户端文件名不能控制保存路径；同时明确由谁负责删除" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="extract-1">
          <mxGeometry x="840" y="535" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fe-mime" value="&lt;b&gt;根据文件头和内容识别真实格式&lt;/b&gt;&lt;br&gt;扩展名、浏览器 Content-Type 和 fileType 只作提示，不能作为最终依据" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="extract-1">
          <mxGeometry x="840" y="655" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fe-supported" value="真实格式受支持&lt;br&gt;且与声明一致？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=4;" vertex="1" parent="extract-1">
          <mxGeometry x="1000" y="770" width="200" height="94" as="geometry" />
        </mxCell>
        <mxCell id="fe-type" value="识别为哪种格式？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=4;" vertex="1" parent="extract-1">
          <mxGeometry x="1010" y="900" width="180" height="86" as="geometry" />
        </mxCell>
        <mxCell id="fe-txt" value="&lt;b&gt;TXT：逐块严格解码&lt;/b&gt;&lt;br&gt;只接受 UTF-8；拒绝非法字节、NUL 和明显二进制内容；读到第 2001 个完整字符立即停止" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="extract-1">
          <mxGeometry x="430" y="900" width="450" height="92" as="geometry" />
        </mxCell>
        <mxCell id="fe-pdf" value="&lt;b&gt;PDF：在独立有界任务中提取&lt;/b&gt;&lt;br&gt;检查前 1024 字节签名，拒绝加密文件；限制 20 页、并发和请求等待超时&lt;br&gt;规范化后超过 2000 个完整字符即失败" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="extract-1">
          <mxGeometry x="1320" y="900" width="450" height="92" as="geometry" />
        </mxCell>
        <mxCell id="fe-normal" value="&lt;b&gt;统一整理提取后的文本&lt;/b&gt;&lt;br&gt;去除 BOM、统一换行、清理首尾空白，再按用户看到的完整字符（Unicode code point）重新计数" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="extract-1">
          <mxGeometry x="850" y="1080" width="500" height="76" as="geometry" />
        </mxCell>
        <mxCell id="fe-length" value="最终文本为 1～2000 字？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=4;" vertex="1" parent="extract-1">
          <mxGeometry x="985" y="1195" width="230" height="94" as="geometry" />
        </mxCell>
        <mxCell id="fe-clean" value="&lt;b&gt;无条件关闭并清理本次提取资源&lt;/b&gt;&lt;br&gt;关闭 PDF/输入流，释放提取执行名额，删除临时文件；任何路径都必须经过清理" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="extract-1">
          <mxGeometry x="830" y="1320" width="540" height="82" as="geometry" />
        </mxCell>
        <mxCell id="fe-ok" value="&lt;b&gt;清理完成，输出规范化 JD&lt;/b&gt;&lt;br&gt;进入“创建岗位与入队”流程&lt;br&gt;只传文本，不保存原文件或临时路径" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="extract-1">
          <mxGeometry x="1480" y="1320" width="540" height="82" as="geometry" />
        </mxCell>
        <mxCell id="fe-e-size" value="FILE_SIZE_EXCEEDED&lt;br&gt;实际上传数据超过配置上限&lt;br&gt;停止读取并删除已写入的临时内容" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="extract-1">
          <mxGeometry x="80" y="415" width="500" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fe-e-type" value="FILE_TYPE_NOT_SUPPORTED：声明不是 PDF/TXT&lt;br&gt;FILE_CONTENT_INVALID：签名或实际内容不匹配&lt;br&gt;删除临时文件后结束" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="extract-1">
          <mxGeometry x="80" y="772" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fe-e-txt" value="FILE_CONTENT_INVALID：非 UTF-8 或含二进制控制字符&lt;br&gt;FILE_EXTRACTION_TIMEOUT / JD_CONTENT_TOO_LONG&lt;br&gt;关闭流并删除临时文件后返回" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="extract-1">
          <mxGeometry x="20" y="896" width="370" height="100" as="geometry" />
        </mxCell>
        <mxCell id="fe-e-pdf" value="PDF_ENCRYPTED / PDF_PAGE_LIMIT_EXCEEDED&lt;br&gt;FILE_READ_FAILED / FILE_EXTRACTION_TIMEOUT&lt;br&gt;FILE_EXTRACTION_BUSY / JD_CONTENT_TOO_LONG&lt;br&gt;关闭 PDF 并删除临时文件后返回" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="extract-1">
          <mxGeometry x="1810" y="892" width="370" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fe-e-text" value="JD_CONTENT_EMPTY / JD_CONTENT_TOO_LONG&lt;br&gt;规范化后为空或超过 2000 字&lt;br&gt;删除临时文件后结束" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="extract-1">
          <mxGeometry x="80" y="1200" width="500" height="82" as="geometry" />
        </mxCell>
        <mxCell id="fe-e-clean" value="临时文件删除未确认&lt;br&gt;当前实现只记录脱敏告警，不新增业务错误码&lt;br&gt;带固定前缀的孤儿文件由下次启动按年龄补偿清理" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="extract-1">
          <mxGeometry x="200" y="1317" width="500" height="88" as="geometry" />
        </mxCell>
        <mxCell id="fe-config" value="&lt;b&gt;上线前必须配置并压测&lt;/b&gt;&lt;br&gt;10 MiB 实际字节、PDF 20 页、2000 code point、15 秒请求等待、有界线程/队列和非持久临时目录。&lt;br&gt;网关/容器 multipart 上限必须与业务上限一致或更严格。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="extract-1">
          <mxGeometry x="1510" y="390" width="620" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fe-owner" value="&lt;b&gt;临时文件只能有一个清理负责人&lt;/b&gt;&lt;br&gt;提取任务接手前由请求线程负责；接手后由提取任务在 finally 中负责。&lt;br&gt;请求超时只停止等待；Worker 真实结束后清理，异常遗留由下次启动清扫。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="extract-1">
          <mxGeometry x="1510" y="515" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="fe-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="extract-1" source="fe-s" target="fe-front"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="extract-1" source="fe-front" target="fe-upload"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="extract-1" source="fe-upload" target="fe-size"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-e3x" value="超过上限" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="extract-1" source="fe-size" target="fe-e-size"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-e4" value="未超限" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="extract-1" source="fe-size" target="fe-temp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="extract-1" source="fe-temp" target="fe-mime"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="extract-1" source="fe-mime" target="fe-supported"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-eu" value="不支持或不一致" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="extract-1" source="fe-supported" target="fe-e-type"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-es" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="extract-1" source="fe-supported" target="fe-type"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-et" value="TXT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="extract-1" source="fe-type" target="fe-txt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-ep" value="PDF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="extract-1" source="fe-type" target="fe-pdf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-etx" value="提取失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="extract-1" source="fe-txt" target="fe-e-txt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-epx" value="提取失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="extract-1" source="fe-pdf" target="fe-e-pdf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-etn" value="提取成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="extract-1" source="fe-txt" target="fe-normal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="655" y="1118" /></Array></mxGeometry></mxCell>
        <mxCell id="fe-epn" value="提取成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="extract-1" source="fe-pdf" target="fe-normal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1545" y="1118" /></Array></mxGeometry></mxCell>
        <mxCell id="fe-enl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="extract-1" source="fe-normal" target="fe-length"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-elx" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="extract-1" source="fe-length" target="fe-e-text"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-elc" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="extract-1" source="fe-length" target="fe-clean"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-ecx" value="删除未确认：告警" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#d6b656;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="extract-1" source="fe-clean" target="fe-e-clean"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-eco" value="finally 已执行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="extract-1" source="fe-clean" target="fe-ok"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-nc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=1 3;strokeColor=#111827;strokeWidth=2;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="extract-1" source="fe-size" target="fe-config"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=1 3;strokeColor=#111827;strokeWidth=2;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="extract-1" source="fe-temp" target="fe-owner"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe-bottom" value="所有读取、格式和提取错误都会经过唯一责任人的 finally 清理后返回；文本有效才进入创建事务。临时文件删除失败不会伪造新的任务状态，当前实现记录告警，并由下次启动按前缀和年龄补偿清理。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="extract-1">
          <mxGeometry x="250" y="1470" width="1700" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dispatch" name="详细设计-公平调度与领取">
    <mxGraphModel fold="1" pageWidth="1900" dx="1900" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1700" dy="1700" gridSize="10" pageScale="1" page="1" arrows="1">
      <root>
        <mxCell id="dispatch-0" />
        <mxCell id="dispatch-1" parent="dispatch-0" />
        <mxCell id="dispatch-title" value="详细设计：公平调度与任务领取" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="dispatch-1">
          <mxGeometry x="40" y="20" width="1820" height="42" as="geometry" />
        </mxCell>
        <mxCell id="dispatch-subtitle" value="不同用户轮流获得解析机会；同一用户一次只运行一个任务。CPA 没有空位时，任务继续排队，不创建线程也不占数据库连接。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#4b5563;" vertex="1" parent="dispatch-1">
          <mxGeometry x="40" y="64" width="1820" height="30" as="geometry" />
        </mxCell>
        <mxCell id="fd-db" value="&lt;b&gt;MySQL 任务事实：Redis 丢失也不会丢任务&lt;/b&gt;&lt;br&gt;每个岗位最多一条当前任务；保存 taskId、岗位/发起人、queueOwner、四状态、候选或失败信息及起止时间。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="dispatch-1">
          <mxGeometry x="50" y="120" width="430" height="105" as="geometry" />
        </mxCell>
        <mxCell id="fd-redis" value="&lt;b&gt;Redis 公平排队投影：启动时可由 MySQL 重建&lt;/b&gt;&lt;br&gt;ready List + Set：参与者轮转且防重复&lt;br&gt;owner:{queueOwner}:tasks：按 taskId 排序的 ZSet&lt;br&gt;busy Hash：一个参与者同时最多运行一条" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="dispatch-1">
          <mxGeometry x="50" y="250" width="430" height="125" as="geometry" />
        </mxCell>
        <mxCell id="fd-example" value="&lt;b&gt;轮转示例&lt;/b&gt;&lt;br&gt;A 有 A1/A2，B 有 B1，PUBLIC 有 P1/P2，可形成 A1 → B1 → P1 → A2 → P2。新参与者加入当时队尾；完成一轮且仍有任务的参与者也回到队尾。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="dispatch-1">
          <mxGeometry x="50" y="400" width="430" height="115" as="geometry" />
        </mxCell>
        <mxCell id="fd-s" value="出现新任务、任务结束或执行名额释放&lt;br&gt;唤醒一次调度" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;" vertex="1" parent="dispatch-1">
          <mxGeometry x="780" y="115" width="250" height="78" as="geometry" />
        </mxCell>
        <mxCell id="fd-permit" value="&lt;b&gt;先尝试占用一个岗位解析执行名额&lt;/b&gt;&lt;br&gt;立即得到“有空位/无空位”，不在这里等待（技术名：CPA permit）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="dispatch-1">
          <mxGeometry x="700" y="235" width="410" height="76" as="geometry" />
        </mxCell>
        <mxCell id="fd-dp" value="当前有空闲执行名额？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=4;" vertex="1" parent="dispatch-1">
          <mxGeometry x="805" y="355" width="200" height="92" as="geometry" />
        </mxCell>
        <mxCell id="fd-wait" value="&lt;b&gt;没有空位：本轮立即结束&lt;/b&gt;&lt;br&gt;任务仍留在队列；名额释放时再次唤醒&lt;br&gt;不访问数据库，也不创建线程" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="dispatch-1">
          <mxGeometry x="1240" y="360" width="350" height="82" as="geometry" />
        </mxCell>
        <mxCell id="fd-reserve" value="&lt;b&gt;Redis 原子预留下一个参与者及其最早任务&lt;/b&gt;&lt;br&gt;Lua 从 ready 队首取 queueOwner、从其 ZSet 弹出最小 taskId，并写入 busy Hash，防止该参与者被重复领取" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="dispatch-1">
          <mxGeometry x="680" y="500" width="450" height="88" as="geometry" />
        </mxCell>
        <mxCell id="fd-dc" value="选到有效用户和任务？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=4;" vertex="1" parent="dispatch-1">
          <mxGeometry x="805" y="630" width="200" height="92" as="geometry" />
        </mxCell>
        <mxCell id="fd-empty" value="没有有效候选：释放刚占用的执行名额&lt;br&gt;顺手删除空用户或过期队列成员&lt;br&gt;本轮结束" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="dispatch-1">
          <mxGeometry x="1240" y="635" width="350" height="82" as="geometry" />
        </mxCell>
        <mxCell id="fd-claim" value="&lt;b&gt;MySQL 短事务：锁定 Position → 当前 Task 并正式领取&lt;/b&gt;&lt;br&gt;岗位存在且未归档、queueOwner 与岗位类型/所有者一致、当前 taskId 仍为 WAITING&lt;br&gt;条件更新为 RUNNING，记录 startedAt，并返回不可变 AnalysisInput" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="dispatch-1">
          <mxGeometry x="650" y="770" width="510" height="118" as="geometry" />
        </mxCell>
        <mxCell id="fd-da" value="数据库成功把 1 条任务改为运行中？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=4;" vertex="1" parent="dispatch-1">
          <mxGeometry x="795" y="930" width="220" height="96" as="geometry" />
        </mxCell>
        <mxCell id="fd-stale" value="&lt;b&gt;领取失败：按结果清理 Redis 预留&lt;/b&gt;&lt;br&gt;DB 异常未确认时 restore：放回 taskId 并结束 busy；任务无效时 finish：只结束 busy&lt;br&gt;随后释放本地容量；仍有任务才回到 ready 队尾" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="dispatch-1">
          <mxGeometry x="1220" y="925" width="390" height="96" as="geometry" />
        </mxCell>
        <mxCell id="fd-mark" value="&lt;b&gt;数据库领取成功：保留现有 Redis busy 预留&lt;/b&gt;&lt;br&gt;taskId 已在预留时从 ZSet 弹出；参与者在 Worker 真实结束前不回 ready&lt;br&gt;此处不依赖额外 Redis 写入，也没有运行中数据库补扫" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="dispatch-1">
          <mxGeometry x="665" y="1080" width="480" height="98" as="geometry" />
        </mxCell>
        <mxCell id="fd-thread" value="&lt;b&gt;创建一个虚拟线程执行该任务&lt;/b&gt;&lt;br&gt;线程只接收任务 ID 和执行名额上下文；不携带数据库连接，CPA 调用发生在领取事务之外" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="dispatch-1">
          <mxGeometry x="680" y="1225" width="450" height="92" as="geometry" />
        </mxCell>
        <mxCell id="fd-dt" value="创建成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=4;" vertex="1" parent="dispatch-1">
          <mxGeometry x="805" y="1360" width="200" height="92" as="geometry" />
        </mxCell>
        <mxCell id="fd-threadx" value="&lt;b&gt;虚拟线程提交失败&lt;/b&gt;&lt;br&gt;把 RUNNING 收口为 FAILED&lt;br&gt;errorCode=WORKER_SUBMISSION_FAILED；数据库确认收口后结束 busy、释放容量并继续调度" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="dispatch-1">
          <mxGeometry x="1210" y="1348" width="410" height="105" as="geometry" />
        </mxCell>
        <mxCell id="fd-end" value="任务已交给后台执行&lt;br&gt;该用户本次任务结束前不再参与用户轮转" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="dispatch-1">
          <mxGeometry x="755" y="1510" width="300" height="68" as="geometry" />
        </mxCell>
        <mxCell id="fd-n1" value="&lt;b&gt;为什么必须先拿执行名额&lt;/b&gt;&lt;br&gt;没有 CPA 空位时不创建大量等待线程，也不会先把某个用户从轮转队列拿走后让他长时间占位。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="dispatch-1">
          <mxGeometry x="1390" y="120" width="430" height="100" as="geometry" />
        </mxCell>
        <mxCell id="fd-n2" value="&lt;b&gt;taskId 与 ready 顺序各管一件事&lt;/b&gt;&lt;br&gt;taskId 同时作为参与者内部 FIFO 和启动恢复的稳定顺序；ready List 只表示当前运行时参与者的轮转先后。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="dispatch-1">
          <mxGeometry x="1390" y="500" width="430" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fd-n3" value="&lt;b&gt;正常调度不会不停扫描数据库&lt;/b&gt;&lt;br&gt;平时从 Redis 找下一位用户；选中任务后只去数据库核对并领取这一个任务，不查询“全系统下一个任务”。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="dispatch-1">
          <mxGeometry x="1390" y="760" width="430" height="100" as="geometry" />
        </mxCell>
        <mxCell id="fd-n4" value="&lt;b&gt;当前并发边界是单应用实例&lt;/b&gt;&lt;br&gt;Semaphore、串行 dispatcher 和虚拟线程执行器都在本机；当前实现不提供多实例总并发或分布式执行租约。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="dispatch-1">
          <mxGeometry x="1390" y="1085" width="430" height="120" as="geometry" />
        </mxCell>
        <mxCell id="fd-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="dispatch-1" source="fd-s" target="fd-permit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="dispatch-1" source="fd-permit" target="fd-dp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-e2y" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="dispatch-1" source="fd-dp" target="fd-reserve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-e2n" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="dispatch-1" source="fd-dp" target="fd-wait">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="dispatch-1" source="fd-reserve" target="fd-dc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-e3y" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="dispatch-1" source="fd-dc" target="fd-claim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-e3n" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="dispatch-1" source="fd-dc" target="fd-empty">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="dispatch-1" source="fd-claim" target="fd-da">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-e4y" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="dispatch-1" source="fd-da" target="fd-mark">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-e4n" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="dispatch-1" source="fd-da" target="fd-stale">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="dispatch-1" source="fd-mark" target="fd-thread">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="dispatch-1" source="fd-thread" target="fd-dt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-e6y" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="dispatch-1" source="fd-dt" target="fd-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-e6n" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="dispatch-1" source="fd-dt" target="fd-threadx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-n1e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=4 4;strokeColor=#9ca3af;strokeWidth=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="dispatch-1" source="fd-n1" target="fd-permit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-n2e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=4 4;strokeColor=#9ca3af;strokeWidth=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="dispatch-1" source="fd-n2" target="fd-reserve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-n3e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=4 4;strokeColor=#9ca3af;strokeWidth=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="dispatch-1" source="fd-n3" target="fd-claim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-n4e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=4 4;strokeColor=#9ca3af;strokeWidth=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="dispatch-1" source="fd-n4" target="fd-mark">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fd-ui" value="&lt;b&gt;queueAhead 只是当前快照&lt;/b&gt;：根据 busy 数、ready 位置和参与者内 taskId rank 估算。新参与者、归档、惰性清理或启动恢复都会让数字变化；Redis 不可用时该值可为空。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="dispatch-1">
          <mxGeometry x="250" y="1610" width="1400" height="58" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="sequence" name="完整时序-CPA执行与结果写回">
    <mxGraphModel fold="1" pageWidth="3200" dx="3200" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1900" dy="1900" gridSize="10" pageScale="1" page="1" arrows="1">
      <root>
        <mxCell id="sequence-0" />
        <mxCell id="sequence-1" parent="sequence-0" />
        <mxCell id="sequence-title" value="完整时序：CPA 执行、候选结果写回与容量释放" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="sequence-1">
          <mxGeometry x="40" y="20" width="3120" height="42" as="geometry" />
        </mxCell>
        <mxCell id="sequence-subtitle" value="MySQL 决定任务最终状态；等待模型回答时不占数据库事务。岗位模块不建立独立总 deadline，模型调用真实返回或抛错后才释放本地执行容量。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#4b5563;" vertex="1" parent="sequence-1">
          <mxGeometry x="40" y="64" width="3120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sq-rule" value="后台只保存 SUCCEEDED 候选；用户确认后写入正式画像并删除当前任务。任何模型异常、空响应、非法 JSON 或无效画像都写为 FAILED，不生成成功兜底画像。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="sequence-1">
          <mxGeometry x="240" y="105" width="2280" height="48" as="geometry" />
        </mxCell>
        <mxCell id="sq-h1" value="公平调度器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="sequence-1">
          <mxGeometry x="80" y="175" width="240" height="58" as="geometry" />
        </mxCell>
        <mxCell id="sq-h1-line" value="" style="shape=line;direction=south;strokeColor=#94a3b8;dashed=1;dashPattern=4 4;" vertex="1" parent="sequence-1">
          <mxGeometry x="200" y="233" width="1" height="1500" as="geometry" />
        </mxCell>
        <mxCell id="sq-h2" value="Redis 调度投影" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="sequence-1">
          <mxGeometry x="390" y="175" width="240" height="58" as="geometry" />
        </mxCell>
        <mxCell id="sq-h2-line" value="" style="shape=line;direction=south;strokeColor=#94a3b8;dashed=1;dashPattern=4 4;" vertex="1" parent="sequence-1">
          <mxGeometry x="510" y="233" width="1" height="1500" as="geometry" />
        </mxCell>
        <mxCell id="sq-h3" value="岗位解析执行名额 / CPA Permit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="sequence-1">
          <mxGeometry x="700" y="175" width="240" height="58" as="geometry" />
        </mxCell>
        <mxCell id="sq-h3-line" value="" style="shape=line;direction=south;strokeColor=#94a3b8;dashed=1;dashPattern=4 4;" vertex="1" parent="sequence-1">
          <mxGeometry x="820" y="233" width="1" height="1500" as="geometry" />
        </mxCell>
        <mxCell id="sq-h4" value="MySQL 任务 / 画像" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="sequence-1">
          <mxGeometry x="1010" y="175" width="240" height="58" as="geometry" />
        </mxCell>
        <mxCell id="sq-h4-line" value="" style="shape=line;direction=south;strokeColor=#94a3b8;dashed=1;dashPattern=4 4;" vertex="1" parent="sequence-1">
          <mxGeometry x="1130" y="233" width="1" height="1500" as="geometry" />
        </mxCell>
        <mxCell id="sq-h5" value="后台解析任务 / 虚拟线程" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="sequence-1">
          <mxGeometry x="1320" y="175" width="240" height="58" as="geometry" />
        </mxCell>
        <mxCell id="sq-h5-line" value="" style="shape=line;direction=south;strokeColor=#94a3b8;dashed=1;dashPattern=4 4;" vertex="1" parent="sequence-1">
          <mxGeometry x="1440" y="233" width="1" height="1500" as="geometry" />
        </mxCell>
        <mxCell id="sq-h6" value="JD Agent / LlmService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="sequence-1">
          <mxGeometry x="1630" y="175" width="240" height="58" as="geometry" />
        </mxCell>
        <mxCell id="sq-h6-line" value="" style="shape=line;direction=south;strokeColor=#94a3b8;dashed=1;dashPattern=4 4;" vertex="1" parent="sequence-1">
          <mxGeometry x="1750" y="233" width="1" height="1500" as="geometry" />
        </mxCell>
        <mxCell id="sq-h7" value="Spring AI / CPA HTTP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="sequence-1">
          <mxGeometry x="1940" y="175" width="240" height="58" as="geometry" />
        </mxCell>
        <mxCell id="sq-h7-line" value="" style="shape=line;direction=south;strokeColor=#94a3b8;dashed=1;dashPattern=4 4;" vertex="1" parent="sequence-1">
          <mxGeometry x="2060" y="233" width="1" height="1500" as="geometry" />
        </mxCell>
        <mxCell id="sq-h8" value="CPA 主模型 / 备用模型" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="sequence-1">
          <mxGeometry x="2250" y="175" width="240" height="58" as="geometry" />
        </mxCell>
        <mxCell id="sq-h8-line" value="" style="shape=line;direction=south;strokeColor=#94a3b8;dashed=1;dashPattern=4 4;" vertex="1" parent="sequence-1">
          <mxGeometry x="2370" y="233" width="1" height="1500" as="geometry" />
        </mxCell>
        <mxCell id="sq-a" value="A 领取与交接" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#374151;" vertex="1" parent="sequence-1">
          <mxGeometry x="20" y="250" width="170" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sq-m1" value="1. 尝试占用一个解析名额（tryAcquire）" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#4b5563;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="290" as="sourcePoint" />
            <mxPoint x="820" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m2" value="有空位 / 暂无空位（无空位时本轮结束）" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4b5563;strokeWidth=1;dashed=1;endArrow=open;endFill=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="330" as="sourcePoint" />
            <mxPoint x="200" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m3" value="2. 原子选择下一位用户及其最早任务（Lua）" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#4b5563;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="375" as="sourcePoint" />
            <mxPoint x="510" y="375" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m4" value="返回用户 ID + 任务 ID / 当前无人等待" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4b5563;strokeWidth=1;dashed=1;endArrow=open;endFill=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="415" as="sourcePoint" />
            <mxPoint x="200" y="415" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m5" value="3. 短事务锁定 Position → Task；核对后 WAITING → RUNNING，返回 AnalysisInput" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#9673a6;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="460" as="sourcePoint" />
            <mxPoint x="1130" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m6" value="成功修改 1 条 / 未修改；返回后领取事务已经结束" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4b5563;strokeWidth=1;dashed=1;endArrow=open;endFill=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1130" y="505" as="sourcePoint" />
            <mxPoint x="200" y="505" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m7" value="4. 领取成功：保留预留时写入的 busy；taskId 已从参与者 ZSet 弹出" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#4b5563;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="550" as="sourcePoint" />
            <mxPoint x="510" y="550" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m8" value="5. 提交虚拟线程；闭包携带 AnalysisInput 与 Redis Reservation，不传数据库连接" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#4b5563;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="595" as="sourcePoint" />
            <mxPoint x="1440" y="595" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-b" value="B 事务外执行模型调用" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#374151;" vertex="1" parent="sequence-1">
          <mxGeometry x="20" y="635" width="200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sq-deadline" value="岗位模块没有 deadlineAt 或独立倒计时；共享 LLM/HTTP 层的真实调用边界决定何时返回，返回前本地 permit 与 Redis busy 均保持占用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="sequence-1">
          <mxGeometry x="1280" y="635" width="1130" height="585" as="geometry" />
        </mxCell>
        <mxCell id="sq-m9" value="6. 虚拟线程开始执行已领取的不可变 AnalysisInput（含 JD、类别、taskId、queueOwner）" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#4b5563;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="690" as="sourcePoint" />
            <mxPoint x="1440" y="690" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m11" value="7. 校验 JD、构建提示词并调用 LlmService.chat" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#4b5563;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1440" y="790" as="sourcePoint" />
            <mxPoint x="1750" y="790" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m12" value="选择 L2 主模型并创建对应 ChatClient" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#4b5563;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1750" y="835" as="sourcePoint" />
            <mxPoint x="2060" y="835" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m13" value="主模型请求" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#4b5563;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2060" y="880" as="sourcePoint" />
            <mxPoint x="2370" y="880" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m14" value="响应或异常" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4b5563;strokeWidth=1;dashed=1;endArrow=open;endFill=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2370" y="925" as="sourcePoint" />
            <mxPoint x="2060" y="925" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m15" value="Spring AI 调用真实返回或抛错" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4b5563;strokeWidth=1;dashed=1;endArrow=open;endFill=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2060" y="970" as="sourcePoint" />
            <mxPoint x="1750" y="970" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m16" value="8. 主模型抛异常且备用配置不同：仅再调用一次备用模型" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#4b5563;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1750" y="1015" as="sourcePoint" />
            <mxPoint x="2060" y="1015" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m17" value="备用模型请求" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#4b5563;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2060" y="1060" as="sourcePoint" />
            <mxPoint x="2370" y="1060" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m18" value="备用响应或最终异常" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4b5563;strokeWidth=1;dashed=1;endArrow=open;endFill=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2370" y="1105" as="sourcePoint" />
            <mxPoint x="1750" y="1105" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m19" value="提取 JSON 并严格校验画像；返回候选，或抛出可分类错误（不做成功降级）" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4b5563;strokeWidth=1;dashed=1;endArrow=open;endFill=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1750" y="1170" as="sourcePoint" />
            <mxPoint x="1440" y="1170" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-c" value="C 短事务收口当前任务" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#374151;" vertex="1" parent="sequence-1">
          <mxGeometry x="20" y="1240" width="190" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sq-m20" value="9. 锁定 Position → 当前 Task；只接受同一 taskId 且源状态仍为 RUNNING" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#9673a6;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1440" y="1290" as="sourcePoint" />
            <mxPoint x="1130" y="1290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m21" value="候选有效：SUCCEEDED；任何分类失败：FAILED；岗位已归档：删除任务；任务已变化：不更新" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4b5563;strokeWidth=1;dashed=1;endArrow=open;endFill=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1130" y="1370" as="sourcePoint" />
            <mxPoint x="1440" y="1370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-d" value="D 释放与下一轮" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#374151;" vertex="1" parent="sequence-1">
          <mxGeometry x="20" y="1450" width="180" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sq-m22" value="10. 清除“该用户正在运行”标记；仍有等待任务时让用户回到轮转队尾" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#4b5563;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1440" y="1500" as="sourcePoint" />
            <mxPoint x="510" y="1500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m23" value="11. 释放本地解析名额（release）；此时模型调用与状态收口均已结束" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#4b5563;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1440" y="1550" as="sourcePoint" />
            <mxPoint x="820" y="1550" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m24" value="容量释放，唤醒下一轮" style="edgeStyle=none;rounded=0;html=1;strokeColor=#4b5563;strokeWidth=1;dashed=1;endArrow=open;endFill=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="1600" as="sourcePoint" />
            <mxPoint x="200" y="1600" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-m25" value="通知调度器：当前任务在数据库中的结果已经落定" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9ca3af;strokeWidth=1;dashed=1;endArrow=open;endFill=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="sequence-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1440" y="1650" as="sourcePoint" />
            <mxPoint x="200" y="1650" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sq-n1" value="&lt;b&gt;领取阶段的 3 个失败出口&lt;/b&gt;&lt;br&gt;没有 permit：任务继续排队。DB 未确认：恢复 Redis 预留并稍后重试。虚拟线程提交失败：任务写 FAILED；若数据库无法确认收口则保留 busy 等下次启动恢复。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="sequence-1">
          <mxGeometry x="2660" y="250" width="470" height="125" as="geometry" />
        </mxCell>
        <mxCell id="sq-n2" value="&lt;b&gt;数据库只在两个短时间点参与&lt;/b&gt;&lt;br&gt;第一次只负责领取任务，第二次只负责保存最终结果。等待 CPA 回答的几分钟内，不占数据库事务和连接。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="sequence-1">
          <mxGeometry x="2660" y="430" width="470" height="115" as="geometry" />
        </mxCell>
        <mxCell id="sq-n3" value="&lt;b&gt;岗位模块不承诺单独的总超时&lt;/b&gt;&lt;br&gt;它依赖共享 LLM/HTTP 层最终返回或抛错；主、备调用都在同一 Worker 内串行发生，真实结束前持续占用一个岗位解析 permit。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="sequence-1">
          <mxGeometry x="2660" y="650" width="470" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sq-n4" value="&lt;b&gt;后台只生成候选画像&lt;/b&gt;&lt;br&gt;解析成功不会直接覆盖正式画像，必须由用户确认后才生效；重新解析失败时，旧正式画像仍可继续用于面试。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="sequence-1">
          <mxGeometry x="2660" y="900" width="470" height="115" as="geometry" />
        </mxCell>
        <mxCell id="sq-n5" value="&lt;b&gt;防止迟到结果覆盖当前事实&lt;/b&gt;&lt;br&gt;每个岗位只有一条当前任务；写回锁定岗位和任务，要求当前 taskId 完全一致且状态仍为 RUNNING。岗位已归档时删除任务并丢弃结果。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="sequence-1">
          <mxGeometry x="2660" y="1240" width="470" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sq-n6" value="&lt;b&gt;结束时按固定顺序释放&lt;/b&gt;&lt;br&gt;先确认 MySQL 已收口，再清除参与者 busy 并按需回 ready，最后归还 permit、唤醒下一轮。MySQL 未确认时故意保留 busy，避免同参与者继续领取。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="sequence-1">
          <mxGeometry x="2660" y="1490" width="470" height="125" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="confirm" name="详细设计-确认与重新解析">
    <mxGraphModel fold="1" pageWidth="1800" dx="1800" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1400" dy="1400" gridSize="10" pageScale="1" page="1" arrows="1">
      <root>
        <mxCell id="confirm-0" />
        <mxCell id="confirm-1" parent="confirm-0" />
        <mxCell id="confirm-title" value="详细设计：候选画像确认与重新解析" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="confirm-1">
          <mxGeometry x="40" y="20" width="1720" height="42" as="geometry" />
        </mxCell>
        <mxCell id="confirm-subtitle" value="确认只发布请求 taskId 对应的当前 SUCCEEDED 候选并删除任务；重新解析删除旧终态任务后创建新 WAITING，旧正式画像继续可用。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#4b5563;" vertex="1" parent="confirm-1">
          <mxGeometry x="40" y="64" width="1720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cr-left" value="确认候选画像" style="swimlane;html=1;startSize=34;horizontal=1;rounded=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=15;fontStyle=1;fontColor=#334155;" vertex="1" parent="confirm-1">
          <mxGeometry x="40" y="110" width="820" height="1170" as="geometry" />
        </mxCell>
        <mxCell id="cr-right" value="重新解析 / 失败重试" style="swimlane;html=1;startSize=34;horizontal=1;rounded=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=15;fontStyle=1;fontColor=#334155;" vertex="1" parent="confirm-1">
          <mxGeometry x="900" y="110" width="860" height="1170" as="geometry" />
        </mxCell>
        <mxCell id="cr-c0" value="用户确认候选画像" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;" vertex="1" parent="confirm-1">
          <mxGeometry x="350" y="160" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cr-c1" value="短事务锁定可管理的活动岗位，再锁定该岗位唯一的当前任务" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="confirm-1">
          <mxGeometry x="300" y="245" width="300" height="62" as="geometry" />
        </mxCell>
