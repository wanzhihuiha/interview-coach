  <diagram id="archive" name="详细设计-归档与永久删除">
    <mxGraphModel fold="1" pageWidth="1800" dx="1800" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1280" dy="1280" gridSize="10" pageScale="1" page="1" arrows="1">
      <root>
        <mxCell id="archive-0" />
        <mxCell id="archive-1" parent="archive-0" />
        <mxCell id="archive-title" value="详细设计：归档与永久删除" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="archive-1">
          <mxGeometry x="40" y="20" width="1720" height="42" as="geometry" />
        </mxCell>
        <mxCell id="archive-subtitle" value="归档立即禁止新面试并删除非运行任务；RUNNING 保留到 Worker 真实结束。永久删除还要求无 RUNNING 任务和 IN_PROGRESS 面试。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#4b5563;" vertex="1" parent="archive-1">
          <mxGeometry x="40" y="64" width="1720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ad-left" value="归档：释放名额，保留数据" style="swimlane;html=1;startSize=34;horizontal=1;rounded=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=15;fontStyle=1;fontColor=#334155;" vertex="1" parent="archive-1">
          <mxGeometry x="40" y="110" width="820" height="1060" as="geometry" />
        </mxCell>
        <mxCell id="ad-right" value="永久删除：不可恢复" style="swimlane;html=1;startSize=34;horizontal=1;rounded=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=15;fontStyle=1;fontColor=#334155;" vertex="1" parent="archive-1">
          <mxGeometry x="900" y="110" width="860" height="1060" as="geometry" />
        </mxCell>
        <mxCell id="ad-a0" value="开始归档" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;" vertex="1" parent="archive-1">
          <mxGeometry x="365" y="160" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ad-a1" value="个人：先锁 sys_user 再锁本人岗位&lt;br&gt;公共：管理员入口锁定公共岗位；随后锁当前任务" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="archive-1">
          <mxGeometry x="290" y="240" width="320" height="62" as="geometry" />
        </mxCell>
        <mxCell id="ad-a2" value="按当前用户查到岗位？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=4;" vertex="1" parent="archive-1">
          <mxGeometry x="355" y="335" width="190" height="84" as="geometry" />
        </mxCell>
        <mxCell id="ad-ax1" value="岗位不存在&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;POSITION_NOT_FOUND&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="archive-1">
          <mxGeometry x="70" y="345" width="230" height="62" as="geometry" />
        </mxCell>
        <mxCell id="ad-a3" value="已经归档？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=4;" vertex="1" parent="archive-1">
          <mxGeometry x="370" y="455" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ad-ar1" value="幂等返回归档成功" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="archive-1">
          <mxGeometry x="610" y="465" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ad-a4" value="当前解析任务处于哪种状态？&lt;br&gt;也可能没有任务" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=4;" vertex="1" parent="archive-1">
          <mxGeometry x="350" y="575" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ad-a5w" value="WAITING：发布队列移除事件&lt;br&gt;并直接删除当前任务" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="archive-1">
