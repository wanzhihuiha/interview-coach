        </mxCell>
        <mxCell id="ad-a5r" value="RUNNING：任务保持原状&lt;br&gt;不设置取消标记，也不提前释放容量" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="archive-1">
          <mxGeometry x="320" y="700" width="260" height="76" as="geometry" />
        </mxCell>
        <mxCell id="ad-a5n" value="SUCCEEDED / FAILED：直接删除任务&lt;br&gt;无任务：无需处理" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="archive-1">
          <mxGeometry x="620" y="710" width="200" height="66" as="geometry" />
        </mxCell>
        <mxCell id="ad-a6" value="同一事务写 archivedAt&lt;br&gt;个人岗位立即释放一个活动岗位名额" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="archive-1">
          <mxGeometry x="250" y="835" width="340" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ad-a7" value="事务提交后：仅 WAITING 删除路径&lt;br&gt;异步从 Redis 移除对应投影" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="archive-1">
          <mxGeometry x="300" y="945" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ad-a8" value="归档成功&lt;br&gt;正式画像保留，但岗位不可新建面试" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="archive-1">
          <mxGeometry x="260" y="1045" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ad-an1" value="归档不等待 RUNNING 结束。模型调用返回或抛错后，Worker 锁定岗位发现已归档，删除当前任务并丢弃结果；之后才结束 Redis busy、归还 permit。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="archive-1">
