        <mxCell id="st-gn1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=4 4;strokeColor=#9ca3af;strokeWidth=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="state-1" source="st-g3" target="st-gn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-api" value="&lt;b&gt;页面展示口径&lt;/b&gt;：profileUsable 与 latestTaskStatus 分开展示；WAITING/RUNNING 每 2 秒轮询且无总时长上限；SUCCEEDED 停止轮询并提示确认；FAILED 停止轮询并允许重试。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="state-1">
          <mxGeometry x="100" y="1550" width="1800" height="60" as="geometry" />
        </mxCell>
