        <mxCell id="ad-d6" value="同一事务按顺序永久删除&lt;br&gt;当前任务（含候选）→ 正式画像 → 岗位" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="archive-1">
          <mxGeometry x="1160" y="835" width="360" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ad-d7" value="历史面试及岗位/画像完整快照保持不变" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="archive-1">
          <mxGeometry x="1160" y="945" width="360" height="68" as="geometry" />
        </mxCell>
        <mxCell id="ad-d8" value="事务提交后返回删除成功&lt;br&gt;此操作不可恢复" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="archive-1">
          <mxGeometry x="1170" y="1050" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ad-dn1" value="只阻止有进行中面试的删除。已结束面试不阻止，因为不再回查岗位或正式画像。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="archive-1">
          <mxGeometry x="1515" y="565" width="215" height="104" as="geometry" />
        </mxCell>
        <mxCell id="ad-dn2" value="永久删除前已明确拒绝 RUNNING，因此不存在仍会写回的后台任务。非运行当前任务如存在会在同一事务删除；历史 Interview 始终保留。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="archive-1">
          <mxGeometry x="1535" y="790" width="195" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ad-dn3" value="永久删除不可撤销；不得级联删除历史面试或覆盖快照。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="archive-1">
          <mxGeometry x="1515" y="1018" width="215" height="82" as="geometry" />
        </mxCell>
        <mxCell id="ad-df1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="archive-1" source="ad-d0" target="ad-d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ad-df2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="archive-1" source="ad-d1" target="ad-d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ad-df2n" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="archive-1" source="ad-d2" target="ad-dx1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ad-df3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="archive-1" source="ad-d2" target="ad-d3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ad-df3n" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="archive-1" source="ad-d3" target="ad-dx2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ad-df4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="archive-1" source="ad-d3" target="ad-d4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ad-df4y" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="archive-1" source="ad-d4" target="ad-dx3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ad-df5" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="archive-1" source="ad-d4" target="ad-d5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ad-df6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="archive-1" source="ad-d5" target="ad-d6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ad-df7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="archive-1" source="ad-d6" target="ad-d7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ad-df8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#9673a6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="archive-1" source="ad-d7" target="ad-d8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ad-dn1e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=4 4;strokeColor=#9ca3af;strokeWidth=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="archive-1" source="ad-d4" target="ad-dn1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ad-dn2e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=4 4;strokeColor=#9ca3af;strokeWidth=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="archive-1" source="ad-d6" target="ad-dn2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ad-legend" value="灰色＝归档与任务清理　红色＝拒绝或不可逆删除　紫色＝事务写入　绿色＝保留或成功结果" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#6b7280;" vertex="1" parent="archive-1">
          <mxGeometry x="180" y="1210" width="1440" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="recovery" name="详细设计-故障恢复与队列补回">
    <mxGraphModel fold="1" pageWidth="2150" dx="2150" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1900" dy="1900" gridSize="10" pageScale="1" page="1" arrows="1">
      <root>
        <mxCell id="recovery-0" />
        <mxCell id="recovery-1" parent="recovery-0" />
        <mxCell id="recovery-title" value="详细设计：应用启动恢复与 Redis 队列重建" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="recovery-1">
          <mxGeometry x="40" y="20" width="2070" height="42" as="geometry" />
        </mxCell>
        <mxCell id="recovery-subtitle" value="恢复只在 ApplicationRunner 启动阶段执行：先用 MySQL 收口遗留任务，再清空并重建本 Goal 的 Redis 投影，全部成功后才启动调度器。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#4b5563;" vertex="1" parent="recovery-1">
          <mxGeometry x="40" y="64" width="2070" height="30" as="geometry" />
        </mxCell>
        <mxCell id="rc-s1" value="ApplicationRunner&lt;br&gt;开始执行" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;" vertex="1" parent="recovery-1">
          <mxGeometry x="560" y="120" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rc-s2" value="Dispatcher&lt;br&gt;autoStartup=false" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;" vertex="1" parent="recovery-1">
          <mxGeometry x="870" y="120" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rc-s3" value="Queue&lt;br&gt;recoveryComplete=false" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;" vertex="1" parent="recovery-1">
          <mxGeometry x="1180" y="120" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rc-merge" value="进入单实例唯一一次启动恢复&lt;br&gt;启动期间到达的入队事件先保存在本地 pendingRecoveryTasks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="recovery-1">
          <mxGeometry x="800" y="245" width="360" height="72" as="geometry" />
        </mxCell>
        <mxCell id="rc-startup" value="MySQL 中存在需要清理或收口的任务？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=4;" vertex="1" parent="recovery-1">
          <mxGeometry x="885" y="360" width="190" height="94" as="geometry" />
        </mxCell>
        <mxCell id="rc-interrupt" value="&lt;b&gt;按 taskId 升序在一个事务中收口&lt;/b&gt;&lt;br&gt;岗位不存在/已归档：删除任务；RUNNING：写 FAILED + APPLICATION_RESTARTED；WAITING owner 无效：写 FAILED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="recovery-1">
          <mxGeometry x="720" y="505" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rc-init" value="取得有效 WAITING 快照并与 pending 合并&lt;br&gt;按 taskId 去重排序；读取 owner 索引后删除本 Goal 全部 Redis Key" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="recovery-1">
          <mxGeometry x="800" y="645" width="360" height="68" as="geometry" />
        </mxCell>
        <mxCell id="rc-query" value="&lt;b&gt;从内存中的有序恢复列表取得下一条 QueueTask&lt;/b&gt;&lt;br&gt;每条只有 taskId + queueOwner；数据库恢复事务此时已经提交" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="recovery-1">
          <mxGeometry x="650" y="765" width="520" height="96" as="geometry" />
        </mxCell>
        <mxCell id="rc-has" value="还有下一条待恢复任务？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=4;" vertex="1" parent="recovery-1">
          <mxGeometry x="1270" y="765" width="220" height="96" as="geometry" />
        </mxCell>
        <mxCell id="rc-zadd" value="校验 taskId 为正数&lt;br&gt;queueOwner 必须是 USER:&amp;lt;id&amp;gt; 或 PUBLIC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="recovery-1">
          <mxGeometry x="1210" y="930" width="340" height="72" as="geometry" />
        </mxCell>
        <mxCell id="rc-users" value="执行幂等 ENQUEUE Lua&lt;br&gt;写参与者 ZSet、ready List/Set 与 owner index；taskId 同时作为 score/member" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="recovery-1">
          <mxGeometry x="1140" y="1045" width="480" height="78" as="geometry" />
        </mxCell>
        <mxCell id="rc-ok" value="本条 Redis 写入成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=4;" vertex="1" parent="recovery-1">
          <mxGeometry x="1270" y="1170" width="220" height="96" as="geometry" />
        </mxCell>
        <mxCell id="rc-cursor" value="继续处理有序列表下一条&lt;br&gt;pending 在整批成功前不清空" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="recovery-1">
          <mxGeometry x="750" y="1185" width="330" height="68" as="geometry" />
        </mxCell>
        <mxCell id="rc-clean" value="全部任务写入成功：清空 pendingRecoveryTasks&lt;br&gt;设置 recoveryComplete=true；旧 ready/busy/ZSet 已在重建前整体清除" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="recovery-1">
          <mxGeometry x="1580" y="765" width="500" height="82" as="geometry" />
        </mxCell>
        <mxCell id="rc-wake" value="显式 dispatcher.start()&lt;br&gt;之后正常调度才可从 Redis 预留并由 MySQL 最终确认领取" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="recovery-1">
          <mxGeometry x="1595" y="900" width="470" height="72" as="geometry" />
        </mxCell>
        <mxCell id="rc-end" value="启动恢复完成&lt;br&gt;岗位调度开放" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="recovery-1">
          <mxGeometry x="1725" y="1015" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="rc-startx" value="MySQL 恢复事务抛出异常&lt;br&gt;RecoveryRunner 无法取得可靠快照" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="recovery-1">
          <mxGeometry x="1320" y="510" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rc-stop" value="异常继续向外传播，Runner 未完成&lt;br&gt;dispatcher.start() 不会执行&lt;br&gt;修复基础设施后重新启动应用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="recovery-1">
          <mxGeometry x="1320" y="620" width="340" height="88" as="geometry" />
        </mxCell>
        <mxCell id="rc-redisx" value="Redis 旧 Key 清理或任一重建写入失败&lt;br&gt;resetAndRestore 抛出异常" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="recovery-1">
          <mxGeometry x="1580" y="1180" width="500" height="72" as="geometry" />
        </mxCell>
        <mxCell id="rc-hold" value="recoveryComplete 保持 false，调度器不启动&lt;br&gt;MySQL WAITING 事实仍在；修复 Redis 后必须重新启动应用完整重建" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="recovery-1">
          <mxGeometry x="1580" y="1295" width="500" height="82" as="geometry" />
        </mxCell>
        <mxCell id="rc-immediate" value="运行中 AFTER_COMMIT 入队有限重试仍失败" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="recovery-1">
          <mxGeometry x="80" y="770" width="400" height="72" as="geometry" />
        </mxCell>
        <mxCell id="rc-keep" value="不回滚已经提交的岗位和任务&lt;br&gt;MySQL 任务仍为 WAITING，taskId 不变&lt;br&gt;记录脱敏告警；本进程可能暂时无法调度该任务" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="recovery-1">
          <mxGeometry x="80" y="885" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="rc-later" value="当前没有 Redis 重连监听或周期 MySQL 补扫&lt;br&gt;该 WAITING 投影依赖下次应用启动重建" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="recovery-1">
          <mxGeometry x="80" y="1015" width="400" height="82" as="geometry" />
        </mxCell>
        <mxCell id="rc-n1" value="&lt;b&gt;四状态的启动处理&lt;/b&gt;&lt;br&gt;RUNNING：改为 FAILED / APPLICATION_RESTARTED，不自动重跑。&lt;br&gt;有效 WAITING：重建 Redis。&lt;br&gt;SUCCEEDED/FAILED：保留在 MySQL，不入队。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="recovery-1">
          <mxGeometry x="80" y="1510" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="rc-n2" value="&lt;b&gt;为什么 Redis 丢了也不会丢任务&lt;/b&gt;&lt;br&gt;MySQL 保存一岗位一条当前任务及四状态；Redis 只是可重建投影。taskId 同时提供参与者内 FIFO 和恢复稳定顺序。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="recovery-1">
          <mxGeometry x="770" y="1510" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="rc-n3" value="&lt;b&gt;重启后顺序能恢复到什么程度&lt;/b&gt;&lt;br&gt;同一参与者严格按 taskId 升序；ready 参与者顺序由全局 taskId 首次出现顺序重建，不承诺还原崩溃前瞬时轮转位置。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="recovery-1">
          <mxGeometry x="1460" y="1510" width="610" height="145" as="geometry" />
        </mxCell>
        <mxCell id="rc-n4" value="&lt;b&gt;启动时不会保留旧 busy&lt;/b&gt;&lt;br&gt;所有遗留 RUNNING 已先收口为 FAILED；resetAndRestore 清空 busy Hash，再只为有效 WAITING 重建 ready 与任务 ZSet。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="recovery-1">
          <mxGeometry x="80" y="1710" width="600" height="140" as="geometry" />
        </mxCell>
        <mxCell id="rc-n5" value="&lt;b&gt;为什么不会一直查数据库&lt;/b&gt;&lt;br&gt;当前只在应用启动扫描一次 MySQL。正常调度从 Redis 取候选，仅在领取时做 MySQL 条件确认；没有重连监听或周期补扫。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="recovery-1">
          <mxGeometry x="770" y="1710" width="600" height="140" as="geometry" />
        </mxCell>
