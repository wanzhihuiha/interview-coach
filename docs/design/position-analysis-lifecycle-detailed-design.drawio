  <diagram id="state" name="状态流转-岗位画像与解析任务">
    <mxGraphModel fold="1" pageWidth="2000" dx="2000" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1630" dy="1630" gridSize="10" pageScale="1" page="1" arrows="1">
      <root>
        <mxCell id="state-0" />
        <mxCell id="state-1" parent="state-0" />
        <mxCell id="state-title" value="状态流转：岗位、正式画像与四状态当前解析任务" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="state-1">
          <mxGeometry x="40" y="20" width="1920" height="42" as="geometry" />
        </mxCell>
        <mxCell id="state-subtitle" value="正式画像和当前解析任务是两个独立事实；任务处于 WAITING、RUNNING、SUCCEEDED 或 FAILED 时，都不会自动删除已有正式画像。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#4b5563;" vertex="1" parent="state-1">
          <mxGeometry x="40" y="64" width="1920" height="30" as="geometry" />
        </mxCell>
        <mxCell id="st-fact" value="&lt;b&gt;页面必须同时看两件互不替代的事实&lt;/b&gt;&lt;br&gt;1. profileUsable：唯一正式画像是否存在；2. latestTaskStatus：当前任务的四状态或无任务。FAILED 只描述本轮失败，不影响已确认画像。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="state-1">
          <mxGeometry x="80" y="105" width="1840" height="70" as="geometry" />
        </mxCell>
        <mxCell id="st-pz" value="轨道 A：岗位生命周期与唯一正式画像（独立于当前解析任务）" style="swimlane;html=1;startSize=34;horizontal=1;rounded=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=15;fontStyle=1;fontColor=#334155;" vertex="1" parent="state-1">
          <mxGeometry x="40" y="200" width="1920" height="430" as="geometry" />
        </mxCell>
        <mxCell id="st-pl1" value="正式画像轨道" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#475569;" vertex="1" parent="state-1">
          <mxGeometry x="70" y="245" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="st-p0" value="岗位活动，但还没有正式画像&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;archivedAt=null · profileUsable=false&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="270" y="235" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="st-p1" value="岗位活动，唯一正式画像已生效&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;archivedAt=null · profileUsable=true&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="710" y="235" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="st-p2" value="当前任务保存了候选画像&lt;br&gt;确认前不替换正式画像，也不能直接用于面试&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;taskId · SUCCEEDED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="1170" y="225" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="st-pl2" value="岗位可用性轨道" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#475569;" vertex="1" parent="state-1">
          <mxGeometry x="70" y="480" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="st-pa" value="岗位正常使用&lt;br&gt;无论是否已经有正式画像&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ACTIVE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="270" y="455" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="st-p3" value="岗位已归档&lt;br&gt;画像保留，但不可新建面试&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ARCHIVED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="state-1">
          <mxGeometry x="870" y="455" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="st-p4" value="岗位已永久删除&lt;br&gt;岗位和画像已移除&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;DELETED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="1470" y="455" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="st-p5" value="重新解析期间，既有正式画像行保持不变并继续用于新面试快照" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="state-1">
          <mxGeometry x="720" y="355" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="st-p6" value="归档或永久删除都不会改动历史面试快照；历史面试始终读取创建时保存的岗位名称、公司、类别和画像" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="state-1">
          <mxGeometry x="630" y="560" width="940" height="50" as="geometry" />
        </mxCell>
        <mxCell id="st-pe" value="taskId 不再命中当前 SUCCEEDED 候选&lt;br&gt;拒绝确认，不修改正式画像" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="state-1">
          <mxGeometry x="1640" y="240" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="st-pe01" value="确认首个 SUCCEEDED 候选" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="state-1" source="st-p0" target="st-p1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-pe21" value="确认当前 taskId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="state-1" source="st-p2" target="st-p1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-pe13" value="用户归档" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="state-1" source="st-pa" target="st-p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-pe34" value="无 RUNNING 任务且无 IN_PROGRESS 面试" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="state-1" source="st-p3" target="st-p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-pn1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=4 4;strokeColor=#9ca3af;strokeWidth=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="state-1" source="st-p1" target="st-p5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-px" value="确认条件不成立" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="state-1" source="st-p2" target="st-pe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-tz" value="轨道 B：每个岗位唯一的当前任务（持久化状态只有 WAITING / RUNNING / SUCCEEDED / FAILED）" style="swimlane;html=1;startSize=34;horizontal=1;rounded=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=15;fontStyle=1;fontColor=#334155;" vertex="1" parent="state-1">
          <mxGeometry x="40" y="660" width="1920" height="560" as="geometry" />
        </mxCell>
        <mxCell id="st-t0" value="为岗位插入唯一的当前任务&lt;br&gt;taskId 也是 FIFO 顺序" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="70" y="755" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="st-t1" value="等待解析&lt;br&gt;等待轮到所属参与者&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;WAITING&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="280" y="745" width="220" height="85" as="geometry" />
        </mxCell>
        <mxCell id="st-t2" value="正在解析&lt;br&gt;已取得本地 permit 与 Redis busy&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;RUNNING&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="570" y="745" width="230" height="85" as="geometry" />
        </mxCell>
        <mxCell id="st-td" value="本次执行成功并得到合格候选？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=4;" vertex="1" parent="state-1">
          <mxGeometry x="900" y="735" width="240" height="105" as="geometry" />
        </mxCell>
        <mxCell id="st-t3" value="合格候选 JSON 已保存&lt;br&gt;等待所有者或管理员确认&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SUCCEEDED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="1240" y="730" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="st-t4" value="确认事务写正式画像&lt;br&gt;并物理删除当前任务&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;无任务（不是 CONFIRMED 状态）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="1610" y="745" width="230" height="85" as="geometry" />
        </mxCell>
        <mxCell id="st-t5" value="归档清理完成&lt;br&gt;当前任务被物理删除&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;无任务（没有 CANCELLED 状态）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="state-1">
          <mxGeometry x="250" y="980" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="st-t6" value="RUNNING 期间岗位被归档&lt;br&gt;任务保持 RUNNING 到模型真实结束&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;无取消标记&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="state-1">
          <mxGeometry x="560" y="970" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="st-tf" value="所有失败分类都收口为同一个 FAILED 状态；差异只保存在 errorCode / errorMessage" style="swimlane;html=1;startSize=42;horizontal=1;rounded=0;fillColor=#fff7f7;strokeColor=#d6a0a0;fontSize=13;fontStyle=1;fontColor=#7f1d1d;" vertex="1" parent="state-1">
          <mxGeometry x="900" y="900" width="900" height="210" as="geometry" />
        </mxCell>
        <mxCell id="st-t7" value="模型调用、空响应、JSON 或画像校验失败&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;FAILED · LLM_*&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="940" y="970" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="st-t8" value="共享调用层抛出超时，或 Worker 被中断&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;FAILED · LLM_TIMEOUT / WORKER_INTERRUPTED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="1230" y="970" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="st-t9" value="线程提交失败或启动发现遗留 RUNNING&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;FAILED · WORKER_SUBMISSION_FAILED / APPLICATION_RESTARTED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="1520" y="970" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="st-tn" value="&lt;b&gt;任何结果保存前都锁定 Position → 当前 Task&lt;/b&gt;：只接受请求 taskId 仍精确命中且状态为 RUNNING。岗位已归档时删除任务并丢弃结果；不存在 generation、画像版本或取消标记。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="state-1">
          <mxGeometry x="420" y="1140" width="1400" height="55" as="geometry" />
        </mxCell>
        <mxCell id="st-te01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="state-1" source="st-t0" target="st-t1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-te12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="state-1" source="st-t1" target="st-t2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-te23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="state-1" source="st-t2" target="st-td">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-tde" value="是：RUNNING → SUCCEEDED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="state-1" source="st-td" target="st-t3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-te34" value="确认当前 taskId 并删除任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="state-1" source="st-t3" target="st-t4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-te15" value="WAITING 时归档：直接删除" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="state-1" source="st-t1" target="st-t5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-te26" value="RUNNING 时归档：先保留任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="state-1" source="st-t2" target="st-t6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-te65" value="Worker 结束后删除任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="state-1" source="st-t6" target="st-t5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-te27" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0;entryY=0;" edge="1" parent="state-1" source="st-td" target="st-tf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-gz" value="轨道 C：重新解析或重试（删除旧终态任务，再创建新的唯一当前任务）" style="swimlane;html=1;startSize=34;horizontal=1;rounded=0;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=15;fontStyle=1;fontColor=#334155;" vertex="1" parent="state-1">
          <mxGeometry x="40" y="1240" width="1920" height="290" as="geometry" />
        </mxCell>
        <mxCell id="st-g1" value="所有者或管理员点击重新解析 / 重试&lt;br&gt;当前任务只允许为空、SUCCEEDED 或 FAILED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="80" y="1325" width="330" height="75" as="geometry" />
        </mxCell>
        <mxCell id="st-g2" value="任务可替换且提交守卫全部通过？&lt;br&gt;个人频控/上限；公共锁/上限" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=4;" vertex="1" parent="state-1">
          <mxGeometry x="490" y="1310" width="280" height="105" as="geometry" />
        </mxCell>
        <mxCell id="st-g3" value="事务内删除旧 SUCCEEDED/FAILED 并 flush&lt;br&gt;再插入新的 WAITING；正式画像不变" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="880" y="1315" width="310" height="95" as="geometry" />
        </mxCell>
        <mxCell id="st-g4" value="新 taskId 在提交后投影到 Redis&lt;br&gt;页面开始跟踪这条当前任务&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;WAITING · taskId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="state-1">
          <mxGeometry x="1300" y="1325" width="270" height="75" as="geometry" />
        </mxCell>
        <mxCell id="st-g5" value="WAITING/RUNNING 不可替换，或频控、等待上限、公共锁守卫未通过" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;spacing=7;" vertex="1" parent="state-1">
          <mxGeometry x="490" y="1450" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="st-gn" value="当前实现不保存任务历史：旧任务与旧候选会被物理删除。重新解析不新增岗位，也不删除或降级已经确认的正式画像。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=9;align=left;verticalAlign=middle;" vertex="1" parent="state-1">
          <mxGeometry x="870" y="1435" width="700" height="70" as="geometry" />
        </mxCell>
        <mxCell id="st-ge12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="state-1" source="st-g1" target="st-g2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-ge23" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="state-1" source="st-g2" target="st-g3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-ge25" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="state-1" source="st-g2" target="st-g5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-ge34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#4b5563;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="state-1" source="st-g3" target="st-g4">
          <mxGeometry relative="1" as="geometry" />
